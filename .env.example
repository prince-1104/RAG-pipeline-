# Environment
ENV=dev

# LLM Provider - Fallback mode: try Gemini first, fall back to OpenRouter
LLM_PROVIDER=fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (used as fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# Storage
# For local storage:
# STORAGE_BACKEND=local
# PDF_BASE_PATH=data/pdfs
# INDEX_BASE_PATH=data/indexes
# UPLOADS_BASE_PATH=.data/uploads

# For Cloudflare R2:
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto
STORAGE_BACKEND=r2

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_openai_api_key_here

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=niyukti_knowledge

# API Configuration
LOG_LEVEL=INFO
REQUESTS_PER_MINUTE=120
MAX_CONTEXT_CHUNKS=12
MIN_RETRIEVAL_CONFIDENCE=0.55

# API Key Authentication (for Niyukti platform)
API_KEY=your_api_key_here
