# Environment
ENV=dev

# LLM Provider
# - chain: configurable primary + fallback (use LLM_PRIMARY_PROVIDER / LLM_FALLBACK_PROVIDER)
# - openai: OpenAI only (no fallback)
# - openai_fallback_gemini: OpenAI primary, Gemini fallback (12s fallback timeout)
# - gemini: Gemini only
LLM_PROVIDER=chain

# Primary/fallback when LLM_PROVIDER=chain (no code change needed to switch)
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini
# Fallback provider timeout: fail fast (do not block job)
LLM_FALLBACK_TIMEOUT_S=12

# OpenAI (GPT primary)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (fallback when LLM_FALLBACK_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (optional; use when LLM_FALLBACK_PROVIDER=openrouter)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AgentBill (usage tracking)
# AGENTBILL_ENABLED=true
# AGENTBILL_API_KEY=your_agentbill_api_key_here
# AGENTBILL_ENDPOINT=https://api.agentbill.io/functions/v1/otel-collector

# LLM perf tuning (primary provider; fallback uses LLM_FALLBACK_TIMEOUT_S)
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
GENERATION_MAX_TOTAL_ATTEMPTS=48
GENERATION_MAX_BATCHES=64
GENERATION_BATCH_SIZE=12
# Debug only: relax schema/guardrails to diagnose rejection-heavy runs
# GENERATION_DEBUG_RELAXED_VALIDATION=false
# GENERATION_DISABLE_GUARDRAILS=false

# Pool generation perf tuning (higher = faster, but watch rate limits)
POOL_GENERATION_MAX_CONCURRENCY=6
POOL_GENERATION_CONTEXT_CHUNKS=6
POOL_GENERATION_CHUNK_CHARS=900
POOL_GENERATION_MIN_ABSOLUTE=10
POOL_GENERATION_MIN_FRACTION=0.2
# Global retrieval rollout
GLOBAL_RETRIEVAL_IGNORE_TENANT=true

# Admin generation perf tuning (per-class parallelism)
ADMIN_GENERATE_MAX_CONCURRENCY=2
ADMIN_GENERATE_CHAPTER_CONCURRENCY=1
# DEBUG_LOG_ENABLED=false

# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# Storage
# For local storage:
# STORAGE_BACKEND=local
# PDF_BASE_PATH=data/pdfs
# UPLOADS_BASE_PATH=.data/uploads

# For Cloudflare R2:
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto
STORAGE_BACKEND=r2

# Embeddings (Qdrant indexing + retrieval)
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CHUNK_TOKENS=384
EMBEDDING_CHUNK_OVERLAP_TOKENS=64
EMBEDDING_HARD_CAP_TOKENS=500

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=niyukti_knowledge

# API Configuration
LOG_LEVEL=INFO
REQUESTS_PER_MINUTE=120
MAX_CONTEXT_CHUNKS=12
MIN_RETRIEVAL_CONFIDENCE=0.55

# API Key Authentication (for Niyukti platform)
API_KEY=your_api_key_here

# Job worker tuning
WORKER_POLL_INTERVAL_S=2
JOB_MAX_RETRIES=3
JOB_RETRY_BASE_DELAY_S=30
JOB_RETRY_MAX_DELAY_S=900
JOB_QUESTIONS_PER_CHUNK=2
# Ingestion contract rollout (warn first, then enforce)
INGEST_ENFORCE_STRICT_METADATA=false
INGEST_WARN_MISSING_METADATA=true
INGEST_DEFAULT_SYLLABUS_VERSION=CBSE_2023
INGEST_DEFAULT_LANGUAGE=en
INGEST_DEFAULT_SOURCE_TYPE=pdf
# WORKER_ID=worker-1
